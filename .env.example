# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE DATABASE INTEGRATION (FREE TIER)
# Project URL dari dashboard Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Anon Public Key dari dashboard Supabase (Settings > API > Project API keys)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# OTOMATISASI WELCOME EMAIL (ZAPIER CATCH HOOK / WEBHOOK)
# Dapatkan dari Zapier: Trigger 'Webhooks by Zapier' > Event: 'Catch Hook'
ZAPIER_WELCOME_EMAIL_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/xxxxxx/yyyyyy/"
