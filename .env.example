# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE DATABASE INTEGRATION (FREE TIER)
# Project URL dari dashboard Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Anon Public Key dari dashboard Supabase (Settings > API > Project API keys)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# BREVO TRANSACTIONAL EMAIL & CRM (AUTHENTICATED & BRANDED DOMAIN: jualrugi.my.id)
# Dapatkan API Key di https://app.brevo.com/settings/keys/api
VITE_BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
BREVO_SENDER_EMAIL="admin@jualrugi.my.id"
BREVO_SENDER_NAME="JualRugi.my.id"

# WEBHOOK INTEGRATION (MAKE.COM / ZAPIER)
# Dapatkan dari Make.com: Scenario > Custom Webhook
VITE_FREE_WELCOME_WEBHOOK="https://hook.eu1.make.com/5kr1yhffihn48ovlbf8pq8gq646gb1gd"
MAKE_WELCOME_EMAIL_WEBHOOK_URL="https://hook.eu1.make.com/5kr1yhffihn48ovlbf8pq8gq646gb1gd"

# ADMIN DASHBOARD ACCESS (SERVER-SIDE CONFIGURATION)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_secure_admin_password_here"

